CONFIG_IDF_TARGET="esp32s3"
# ESP32-S3-WROOM-1 N8R8 (8 MB flash, octal PSRAM)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

CONFIG_SPIRAM=y
# N8R8: octal 80 MHz. N8R2 quad PSRAM: set CONFIG_SPIRAM_MODE_QUAD=y instead.
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Ambient noise cancel (enabled in main.c AFE): NSNet2 + VADNet medium.
# Models are packed into the model partition; do not disable these for fan rooms.
CONFIG_SR_NSN_NSNET2=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_MN_EN_MULTINET7_QUANT=y
CONFIG_MODEL_IN_FLASH=y

# Analog MAX9814 on ADC1. OUT → GPIO 4 (user-confirmed).
CONFIG_MIC_ANALOG_ADC=y
CONFIG_MIC_ADC_GPIO=4
# Soft gain for MAX9814. Keep low when GAIN float / high analog noise (was 16 → saturates).
# 4 + AGC_MAX 128 over-drove ambient and flooded AFE FEED; 3 is the stable point.
CONFIG_MIC_SOFTWARE_GAIN=3

# Show spoken phrases on serial without requiring "Hi ESP" first.
# Disable in menuconfig (Microphone → Skip wake word) to use wake-word mode.
CONFIG_SR_ALWAYS_LISTEN=y

# MIC rms for mic_compare.py. Off by default — UART spam stalls feed and floods AFE.
# Enable in menuconfig when running tools/mic_compare.py.
CONFIG_MIC_RMS_DEBUG=n
